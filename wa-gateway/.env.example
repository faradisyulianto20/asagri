PORT=4100

# Token yang sama dengan WA_AUTH_TOKEN di backend
AUTH_TOKEN=ganti-dengan-token-gateway

# URL backend di Railway (untuk cadangan session, tanpa trailing slash)
BACKEND_URL=https://your-backend.up.railway.app
# Token yang sama dengan API_TOKEN di backend
BACKEND_TOKEN=ganti-dengan-token-acak-panjang

# Folder session (pakai Railway Volume di /app/session)
SESSION_DIR=/app/session
