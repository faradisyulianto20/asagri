# Supabase Postgres (Settings -> Database -> Connection string)
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Token acak untuk ESP32 & akses session (boleh sama untuk keduanya)
API_TOKEN=ganti-dengan-token-acak-panjang

# Password admin untuk halaman Pengaturan & Simulasi di dashboard
# Akun admin dibuat otomatis saat pertama kali backend dijalankan
ADMIN_USERNAME=asagri@gmail.com
ADMIN_PASSWORD=ppkoasagri

# URL service wa-gateway di Railway (tanpa trailing slash)
WA_GATEWAY_URL=https://your-wa-gateway.up.railway.app

# Token yang dibagi dengan wa-gateway
WA_AUTH_TOKEN=ganti-dengan-token-gateway

# Nomor WhatsApp tujuan (format internasional, tanpa +)
WHATSAPP_TO=6281234567890

# Ambang suhu & kelembaban (harus sama dengan yang ada di ESP32)
THRESHOLD_FAN_ON=32.0
THRESHOLD_FAN_OFF=25.0
THRESHOLD_HUMID_ON=61.0
THRESHOLD_HUMID_OFF=83.0
EXTREME_TEMP=40.0
EXTREME_HUMIDITY=50.0

# Jeda minimum antar notifikasi (menit)
COOLDOWN_MINUTES=15
